/* Component sheets for the extension controls. Each component owns its USS and reads only
   ThemeTokens variables (Runtime/Styles/ThemeTokens.uss, imported by the panel theme, never by this sheet). */
@import url("../Controls/Stepper/SegmentedControl.uss");
@import url("../Controls/BottomSheet/BottomSheet.uss");
@import url("../Controls/GradientFill/GradientFill.uss");
@import url("../Controls/ModalDialog/ModalDialog.uss");
@import url("../Controls/PillButton/PillButtonVariants.uss");
@import url("../Controls/ToastHost/ToastHost.uss");
@import url("../Controls/StatusChip/StatusChip.uss");
@import url("../Controls/Switch/Switch.uss");
@import url("../Controls/SettingsRow/SettingsRow.uss");
@import url("../Controls/OrnamentBar/OrnamentBar.uss");
@import url("../Controls/ScrollingTabs/ScrollingTabs.uss");
@import url("../Controls/SearchField/SearchField.uss");
@import url("../Controls/EmptyState/EmptyState.uss");
@import url("../Controls/SkeletonTile/SkeletonTile.uss");
@import url("../Controls/ProgressRing/ProgressRing.uss");
@import url("../Controls/StatusList/StatusList.uss");
@import url("../Controls/CollapsibleSection/CollapsibleSectionCard.uss");
@import url("../Controls/CoachingOverlay/CoachingOverlay.uss");
@import url("../Controls/ContentGrid/ContentGrid.uss");
@import url("../Controls/SectionList/SectionList.uss");
@import url("../Controls/SideDrawer/SideDrawer.uss");
@import url("../Controls/ScreenHeader/ScreenHeaderCompact.uss");
@import url("../Controls/RoundedInputField/RoundedInputFieldThemed.uss");
@import url("../Controls/WorldAnchoredLabel/WorldAnchoredLabel.uss");
@import url("../Controls/ToolRail/ToolRail.uss");
@import url("../Controls/GestureHint/GestureHint.uss");
@import url("../Controls/AudioGuidePlayer/AudioGuidePlayer.uss");
@import url("../Controls/EntryGate/EntryGate.uss");
@import url("../Controls/LinearProgress/LinearProgress.uss");
@import url("../Controls/AvatarPortrait/AvatarPortrait.uss");
@import url("../Controls/ShutterButton/ShutterButton.uss");
@import url("../Controls/AchievementRow/AchievementRow.uss");
@import url("../Controls/CaptionBar/CaptionBar.uss");
@import url("../Controls/PromptChoices/PromptChoices.uss");
@import url("../Controls/SpeechInputPanel/HoldToTalk.uss");
@import url("../Controls/SpeechInputPanel/SpeechInputPanel.uss");
@import url("../Controls/ContextPill/ContextPill.uss");
@import url("../Controls/ScanFrame/ScanFrame.uss");
@import url("../Controls/QRCodeView/QRCodeView.uss");
@import url("../Controls/HintImageCard/HintImageCard.uss");
@import url("../Controls/WayfinderCard/WayfinderCard.uss");
@import url("../Controls/PanZoomMapView/PanZoomMapView.uss");
@import url("../Controls/MapStopCard/MapStopCard.uss");
@import url("../Controls/TrailStrip/TrailStrip.uss");
@import url("../Controls/WayfinderChips/WayfinderChips.uss");
@import url("../Controls/StorageBar/StorageBar.uss");
@import url("../Controls/NotificationCentre/NotificationCentre.uss");
@import url("../Controls/BadgeTile/BadgeTile.uss");
@import url("../Controls/AchievementCard/AchievementCard.uss");
@import url("../Controls/ScanControls/ScanControls.uss");
@import url("../Controls/PublishPanel/PublishPanel.uss");
@import url("../Controls/FilterChipRow/FilterChipRow.uss");
@import url("../Controls/RadialMenu/RadialMenu.uss");
@import url("../Controls/NumericField/NumericField.uss");
@import url("../Controls/SafeAreaRoot/SafeAreaRoot.uss");
@import url("../Controls/BreakpointRoot/BreakpointRoot.uss");

:root {
	--quadrantStepper-background-color: #e6e6e6;
	--quadrantStepper-label-color: #000000;
	--quadrantStepper-label-selected-color: #ffffff;
	--quadrantStepper-overlay-color: #458398;
	--quadrantStepper-icon-size: 50px;
	--quadrantStepper-border-radius-medium: 30px;
	--quadrantStepper-focus-color: #7FC7D9;
}

/* Components that read ThemeTokens carry this class; the probe lets them warn when the theme lacks the tokens. */
.uitk-themed {
	--uitk-themed: 1;
	--uitk-tokens: var(--theme-tokens);
}

/* ScrollSnap */
.scrollSnap {
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	min-height: 0;
}

.scrollSnap__scroll {
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	min-height: 0;
}

.scrollSnap__content {
	flex-direction: row;
	flex-wrap: nowrap;
}

.scrollSnap__page {
	flex-grow: 0;
	flex-shrink: 0;
}

/* Quadrant Stepper */
.quadrantStepper {
	--quadrantStepper-animation-duration-ms: var(--quadrantStepper-animation-duration-ms-global);
	display: flex;
	flex-direction: row;
	align-items: stretch;
	flex-wrap: nowrap;
	min-width: 240px;
	min-height: 42px;

	background-color: var(--quadrantStepper-background-color);
	border-radius: var(--quadrantStepper-border-radius-medium);
	overflow: hidden;
}

.quadrantStepper > .quadrantStepper__overlay {
	position: absolute;
	top: 5%;
	bottom: 5%;
	left: 0;

	background-color: var(--quadrantStepper-overlay-color);
	border-radius: var(--quadrantStepper-border-radius-medium);
}

.quadrantStepper > .quadrantStepper__segments {
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: row;
	align-items: stretch;
	flex-wrap: nowrap;
}

.quadrantStepper > .quadrantStepper__segments > .quadrantStepper__segment {
	flex-grow: 1;
	flex-shrink: 1;
	flex-basis: 0;

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.quadrantStepper > .quadrantStepper__segments > .quadrantStepper__segment > .quadrantStepper__label {
	-unity-text-align: middle-center;
	font-size: var(--normal-font-size, 14px);
	-unity-font-style: bold;
	color: var(--quadrantStepper-label-color);
}

.quadrantStepper > .quadrantStepper__segments > .quadrantStepper__segment.is-selected > .quadrantStepper__label {
	color: var(--quadrantStepper-label-selected-color);
}

.quadrantStepper .quadrantStepper__icon {
	width: var(--quadrantStepper-icon-size);
	height: var(--quadrantStepper-icon-size);
	flex-shrink: 0;
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: var(--quadrantStepper-label-color);
}

.quadrantStepper .quadrantStepper__icon.is-selected {
	-unity-background-image-tint-color: var(--quadrantStepper-label-selected-color);
}

.quadrantStepper .quadrantStepper__segment--disabled {
	opacity: 0.4;
}

.quadrantStepper:focus > .quadrantStepper__overlay {
	border-width: 2px;
	border-color: var(--quadrantStepper-focus-color);
}

/* Content sizing: segments as wide as their content; the row scrolls when wider than the control */
.quadrantStepper--content > .quadrantStepper__segments {
	width: auto;
	flex-shrink: 0;
}

.quadrantStepper--content > .quadrantStepper__segments > .quadrantStepper__segment {
	flex-grow: 0;
	flex-shrink: 0;
	flex-basis: auto;
	padding-left: 16px;
	padding-right: 16px;
}

/* GrayscaleImage */
.grayscaleImage {
	flex-grow: 1;
}

/* RoundedInputField */
.roundedInputField {
	flex-grow: 1;
	background-color: rgba(255, 255, 255, 0.04);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.14);
	border-radius: 14px;
	overflow: hidden;
}

.roundedInputField.roundedInputField--invalid {
	border-width: 1.5px;
	border-color: var(--c-warn, #E8B04B);
}

.roundedInputField__textField {
	flex-grow: 1;
	margin: 0;
	background-color: rgba(0, 0, 0, 0);
	border-width: 0;
}

.roundedInputField__input {
	background-color: rgba(0, 0, 0, 0);
	border-width: 0;
	padding-left: 16px;
	padding-right: 16px;
	padding-top: 12px;
	padding-bottom: 12px;
	-unity-text-align: middle-left;
}

.roundedInputField__placeholder {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	padding-left: 16px;
	color: rgba(190, 200, 225, 0.9);
	-unity-text-align: middle-left;
}

/* IconLabelButton */
.iconLabelButton {
	flex-direction: row;
}

.iconLabelButton__button {
	flex-grow: 1;
	flex-direction: row;
	align-items: center;
}

.iconLabelButton__icon {
	width: 24px;
	height: 24px;
	flex-shrink: 0;
	background-image: url("../Assets/Icons/ListItem.svg");
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgba(128, 128, 128, 1);
}

.iconLabelButton__label {
	flex-grow: 1;
}

/* CollapsibleSection */
.collapsibleSection__header {
	flex-direction: row;
	align-items: center;
}

.collapsibleSection__title {
	flex-grow: 1;
}

.collapsibleSection__titles {
	flex-grow: 1;
	flex-shrink: 1;
}

.collapsibleSection__subtitle {
	font-size: 11px;
	opacity: 0.7;
}

.collapsibleSection__leading {
	flex-shrink: 0;
	margin-right: 12px;
}

.collapsibleSection__trailing {
	flex-direction: row;
	align-items: center;
	flex-shrink: 0;
	margin-left: 8px;
}

.collapsibleSection__chevron {
	width: 20px;
	height: 20px;
	flex-shrink: 0;
	background-image: url("../Assets/Icons/ChevronDown.svg");
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgba(128, 128, 128, 1);
	rotate: 0deg;
	transition-property: rotate;
	transition-duration: 200ms;
	transition-timing-function: ease-out;
}

.collapsibleSection--expanded .collapsibleSection__chevron {
	rotate: 180deg;
}

.collapsibleSection__body {
	overflow: hidden;
	max-height: 0;
	transition-property: max-height;
	transition-duration: 250ms;
	transition-timing-function: ease-out;
}

.collapsibleSection--expanded > .collapsibleSection__body {
	max-height: 2000px;
}

.collapsibleSection__bodyContent {
	padding-top: 4px;
}

/* LoadingIcon */
.loadingIcon {
	align-items: center;
	justify-content: center;
	opacity: 0;
	transition-property: opacity;
	transition-duration: 200ms;
	transition-timing-function: ease-out;
}

.loadingIcon__image {
	width: 40px;
	height: 40px;
	background-image: url("../Assets/Icons/LoadingSpinner.svg");
	-unity-background-image-tint-color: rgba(255, 255, 255, 1);
	-unity-background-scale-mode: scale-to-fit;
}

.loadingIcon--visible {
	opacity: 1;
}

/* PillInputField */
.pillInputField {
	flex-direction: column;
}

.pillInputField__label {
	display: none;
	font-size: 12px;
	color: rgba(173, 183, 210, 0.85);
	margin-left: 4px;
	margin-bottom: 6px;
	-unity-text-align: upper-left;
}

.pillInputField__input {
	flex-grow: 1;
	margin: 0;
	min-height: 44px;
	justify-content: center;
	background-color: rgba(255, 255, 255, 0.04);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.14);
	border-radius: 22px;
}

.pillInputField__input .unity-text-field__input,
.pillInputField__input .unity-base-text-field__input {
	flex-grow: 1;
	background-color: rgba(0, 0, 0, 0);
	background-image: none;
	border-width: 0;
	margin: 0;
	padding-left: 16px;
	padding-right: 16px;
	-unity-text-align: middle-left;
}

.pillInputField__input .unity-text-field__placeholder,
.pillInputField__input .unity-base-text-field__placeholder {
	color: rgba(190, 200, 225, 0.9);
	-unity-text-align: middle-left;
}

/* PillSelector */
.pillSelector {
	flex-direction: column;
}

.pillSelector__label {
	display: none;
	font-size: 12px;
	color: rgba(173, 183, 210, 0.85);
	margin-left: 4px;
	margin-bottom: 6px;
	-unity-text-align: upper-left;
}

.pillSelector__container {
	flex-direction: row;
	align-items: center;
	min-height: 44px;
	background-color: rgba(255, 255, 255, 0.04);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.14);
	border-radius: 22px;
	padding-left: 16px;
	padding-right: 14px;
}

.pillSelector__clickableLabel {
	flex-grow: 1;
	-unity-text-align: middle-left;
}

.pillSelector__icon {
	width: 16px;
	height: 16px;
	flex-shrink: 0;
	background-image: url("../Assets/Icons/ChevronRight.svg");
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgba(128, 128, 128, 1);
}

/* ComingSoonMessage */
.comingSoonMessage {
	flex-grow: 1;
	align-items: center;
	justify-content: center;
}

.comingSoonMessage__background {
	align-items: center;
}

.comingSoonMessage__title {
	-unity-text-align: middle-center;
}

.comingSoonMessage__label {
	-unity-text-align: middle-center;
}

/* CircularImageButton */
.circularImageButton {
	position: relative;
}

.circularImageButton__image {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	border-radius: 50%;
	-unity-background-scale-mode: scale-and-crop;
}

.circularImageButton__noImageOverlay {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	align-items: center;
	justify-content: center;
}

.circularImageButton__icon {
	width: 40%;
	height: 40%;
	background-image: url("../Assets/Icons/Camera.svg");
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgba(180, 180, 180, 1);
}

.circularImageButton--hasImage .circularImageButton__noImageOverlay {
	display: none;
}

.circularImageButton__uploadLabel {
	margin-top: 8px;
	color: rgba(255, 255, 255, 1);
	-unity-text-align: middle-center;
	white-space: normal;
	font-size: 13px;
	padding-left: 12px;
	padding-right: 12px;
	max-width: 80%;
}

/* ImageCropOverlayControl */
.imageCropOverlay {
	background-color: rgba(8, 10, 16, 0.95);
	align-items: stretch;
	justify-content: center;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.imageCropOverlay__panel {
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background-color: rgba(0, 0, 0, 0);
	max-width: 1400px;
	align-self: center;
}

.imageCropOverlay__header {
	width: 100%;
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	padding-bottom: 28px;
	padding-left: 12px;
	padding-right: 12px;
}

.imageCropOverlay__title {
	font-size: 30px;
	color: rgba(255, 255, 255, 1);
	-unity-text-align: middle-center;
	white-space: normal;
	-unity-font-style: bold;
}

.imageCropOverlay__viewportHost {
	width: 100%;
	flex-grow: 0;
	flex-shrink: 0;
	align-items: center;
	justify-content: center;
}

.imageCropOverlay__viewport {
	position: relative;
	overflow: hidden;
	background-color: rgba(255, 255, 255, 0.06);
	border-width: 4px;
	border-color: rgba(255, 255, 255, 0.9);
}

.imageCropOverlay__image {
	position: absolute;
	background-position: center center;
	background-repeat: no-repeat;
	-unity-background-scale-mode: stretch-to-fill;
	background-color: rgba(0, 0, 0, 0);
}

.imageCropOverlay__footer {
	width: 100%;
	flex-shrink: 0;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding-top: 28px;
	padding-left: 12px;
	padding-right: 12px;
}

.imageCropOverlay__buttonSlot {
	width: 280px;
	max-width: 42%;
	height: 56px;
	flex-shrink: 1;
	flex-grow: 1;
}

.imageCropOverlay__button {
	width: 100%;
	height: 100%;
}

/* DropDownControl */
.dropDownControl {
	position: relative;
	flex-direction: column;
	flex-shrink: 0;
	flex-grow: 0;
	min-width: 160px;
}

.dropDownControl__trigger {
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 56px;
	padding: 0;
	border-width: 1px;
	border-radius: 18px;
	border-color: rgba(255, 255, 255, 0.2);
	background-color: rgba(17, 23, 34, 0.8);
}

.dropDownControl__triggerLabel {
	flex-grow: 1;
	color: rgba(255, 255, 255, 1);
	font-size: 16px;
	-unity-text-align: middle-right;
	padding-left: 16px;
	padding-right: 8px;
	white-space: nowrap;
}

.dropDownControl__triggerIcon {
	width: 18px;
	height: 18px;
	margin-right: 14px;
	background-image: url("../Assets/Icons/ChevronRight.svg");
	-unity-background-image-tint-color: rgba(255, 255, 255, 0.75);
	-unity-background-scale-mode: scale-to-fit;
	background-color: rgba(0, 0, 0, 0);
	rotate: 90deg;
}

.dropDownControl__backdrop {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.001);
}

.dropDownControl__panel {
	position: relative;
	width: auto;
	background-color: rgba(14, 18, 28, 0.98);
	border-radius: 24px;
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.12);
	overflow: hidden;
	align-items: stretch;
}

.dropDownControl__viewport {
	width: 100%;
	height: 672px;
	overflow: hidden;
	padding: 0;
	margin: 0;
}

.dropDownControl__list {
	width: 100%;
	flex-direction: column;
	padding: 0;
	margin: 0;
}

.dropDownControl__row {
	width: 100%;
	height: 96px;
	padding: 0;
	margin: 0;
	flex-shrink: 0;
	align-items: center;
	justify-content: center;
	color: rgba(255, 255, 255, 1);
	font-size: 26px;
	-unity-text-align: middle-center;
	opacity: 1;
}

.dropDownControl__selectionLane {
	position: absolute;
	left: 16px;
	right: 16px;
	top: 288px;
	height: 96px;
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.12);
	border-radius: 16px;
	background-color: rgba(255, 255, 255, 0.04);
}

.dropDownControl__fadeTop {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 288px;
	background-color: rgba(14, 18, 28, 1);
	opacity: 0.55;
	border-bottom-width: 48px;
	border-bottom-color: rgba(14, 18, 28, 1);
}

.dropDownControl__fadeBottom {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 288px;
	background-color: rgba(14, 18, 28, 1);
	opacity: 0.55;
	border-top-width: 48px;
	border-top-color: rgba(14, 18, 28, 1);
}

/* ToggleButton */
.toggleButton {
	align-items: center;
	justify-content: center;
}

.toggleButton__image {
	width: 100%;
	height: 100%;
	-unity-background-scale-mode: scale-to-fit;
}

/* ColorToggleButton */
.colorToggleButton {
	width: 44px;
	height: 44px;
	margin: 4px;
}

.toggleButton__icon {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	border-radius: 50%;
}

.toggleButton__ripple {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	border-radius: 50%;
	opacity: 0;
	scale: 1 1 1;
}

.toggleButton__rippleSecondary {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	border-radius: 50%;
	opacity: 0;
	scale: 1 1 1;
}

.toggleButton__selectedOverlay {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	border-radius: 50%;
	opacity: 0;
	border-width: 3px;
	border-color: rgba(255, 255, 255, 0.9);
}

.toggleButton__selectedOverlay--visible {
	opacity: 1;
}

/* ColorToggleGroup */
.colorToggleGroup {
	flex-grow: 1;
}

.colorToggleGroup__container {
	flex-direction: column;
	flex-grow: 1;
}

/* PageDotIndicator */
.pageDotIndicator {
	align-items: center;
	justify-content: center;
}

.pageDotIndicator__dotsContainer {
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.pageDotIndicator__dot {
	width: 8px;
	height: 8px;
	border-radius: 4px;
	margin-left: 4px;
	margin-right: 4px;
}

/* StepProgressBar */
.stepProgressBar {
	min-height: 6px;
}

.stepProgressBar__background {
	flex-grow: 1;
	border-radius: 4px;
	overflow: hidden;
}

.stepProgressBar__fill {
	height: 100%;
}

/* PillButton */
.pillButton {
	min-height: 40px;
}

.pillButton__background {
	border-radius: 50px;
	overflow: hidden;
	align-items: center;
	justify-content: center;
	flex-grow: 1;
	-unity-background-scale-mode: stretch-to-fill;
}

.pillButton__flash {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(255, 255, 255, 1);
	opacity: 0;
	transition-property: opacity;
	transition-duration: 100ms;
	transition-timing-function: ease-out;
}

.pillButton__flash--active {
	opacity: 0.25;
}

.pillButton__label {
	-unity-text-align: middle-center;
	flex-grow: 1;
	color: rgb(255, 255, 255);
	padding-left: 12px;
	padding-right: 12px;
}

/* PillButton leading icon: the icon and label centre together in a row */
.pillButton__icon {
	width: 20px;
	height: 20px;
	flex-shrink: 0;
	margin-right: 8px;
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: rgb(255, 255, 255);
}

.pillButton.pillButton--hasIcon > .pillButton__background {
	flex-direction: row;
	padding-left: 16px;
	padding-right: 16px;
}

.pillButton.pillButton--hasIcon .pillButton__label {
	flex-grow: 0;
	flex-shrink: 1;
	margin-left: 0;
	margin-right: 0;
	padding-left: 0;
	padding-right: 0;
}

/* NotificationBadge */
.notificationBadge {
	min-width: 18px;
	height: 18px;
	border-radius: 9px; /* half its 18 px height: a pill when it widens for two digits */
	background-color: rgb(229, 72, 77);
	align-items: center;
	justify-content: center;
	padding-left: 3px;
	padding-right: 3px;
}

.notificationBadge__count {
	font-size: 11px;
	color: rgb(255, 255, 255);
	-unity-text-align: middle-center;
	-unity-font-style: bold;
}

/* Screen Header*/
.screenHeader {
	width: 100%;
	flex-direction: column;
}

.screenHeader__notchSpacer {
	width: 100%;
	height: 120px;
}

.screenHeader__bar {
	width: 100%;
	height: 80px;
	min-height: 80px;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.screenHeader__action1Button.toggleButton {
	position: absolute;
	width: 64px;
	height: 64px;
	left: 16px;
}

.screenHeader__action4Toggle.toggleButton {
	position: absolute;
	width: 64px;
	height: 64px;
	left: 32px;
	border-radius: 32px;
	border-width: 2px;
	border-color: rgba(255, 255, 255, 0.9);
}

.screenHeader__action2Button.toggleButton,
.screenHeader__action3Button.toggleButton {
	position: absolute;
	width: 64px;
	height: 64px;
	right: 16px;
}

.screenHeader__titles {
	width: 100%;
	align-items: center;
}

.screenHeader__eyebrow {
	font-size: 11px;
	-unity-text-align: middle-center;
}

.screenHeader__title {
	width: 100%;
	font-size: 22px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
	white-space: nowrap;
}

/* SocialLinkContainer */
.socialLinkContainer {
	flex-direction: column;
	align-items: flex-start;
	width: 100%;
	margin-bottom: 25px;
	flex-shrink: 0;
	flex-grow: 0;
	padding-left: 16px;
	padding-right: 16px;
}

.socialLinkContainer__label {
	width: 100%;
	margin-bottom: 8px;
	font-size: 18px;
	-unity-font-style: bold;
}

.socialLinkContainer__container {
	flex-direction: column;
	align-items: flex-start;
	width: 100%;
	margin-bottom: 25px;
	flex-shrink: 0;
	flex-grow: 0;
	border-width: 1px;
	border-radius: 18px;
	border-color: rgba(255, 255, 255, 0.2);
}

.socialLinkContainer__containerChild {
	flex-direction: row;
	align-items: center;
	width: 100%;
	border-color: rgba(255, 255, 255, 0.2);
	border-bottom-width: 1px;
	padding: 12px;
}

.socialLinkContainer__containerChildInput {
	width: 90%;
	height: 48px;
	margin: 0;
}

.socialLinkContainer__containerChildInput > .unity-text-field__input {
	width: 100%;
	height: 100%;
	background-color: rgba(0, 0, 0, 0);
	border-width: 0;
	padding: 10px;
	font-size: 18px;
	-unity-text-align: middle-left;
}

.socialLinkContainer__platformPicker {
	flex-grow: 1;
	width: 90%;
}

.socialLinkContainer__addButton {
	background-color: rgba(0, 0, 0, 0);
	border-width: 0;
	-unity-text-align: middle-left;
	padding: 10px;
	font-size: 18px;
	width: 100%;
}

.socialLinkContainer__containerChildRemoveButton {
	margin-left: auto;
	margin-right: 18px;
	min-height: 40px;
	min-width: 40px;
	background-color: rgba(0, 0, 0, 0);
	border-width: 0;
	font-size: 22px;
	-unity-text-align: middle-center;
}

/* DropDownMenuControl */
.dropDownMenuControl__backdrop {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.001);
}

.dropDownMenuControl__panel {
	position: absolute;
	background-color: rgba(14, 18, 28, 0.98);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.12);
	border-radius: 24px;
	overflow: hidden;
	flex-direction: column;
	align-items: stretch;
}

.dropDownMenuControl__row {
	height: 96px;
	flex-direction: row;
	align-items: center;
	justify-content: flex-start;
	padding-left: 24px;
	padding-right: 24px;
	background-color: rgba(0, 0, 0, 0);
	border-top-width: 1px;
	border-top-color: rgba(255, 255, 255, 0.12);
}

.dropDownMenuControl__row--first {
	border-top-width: 0;
}

.dropDownMenuControl__row:hover {
	background-color: rgba(255, 255, 255, 0.06);
}

.dropDownMenuControl__row:active {
	background-color: rgba(255, 255, 255, 0.12);
}

.dropDownMenuControl__rowLabel {
	flex-grow: 1;
	color: rgba(255, 255, 255, 1);
	font-size: 26px;
	-unity-text-align: middle-left;
}

/* ElasticListView */
.elasticListView {
	flex-grow: 1;
	flex-direction: column;
	min-height: 0;
}

.elasticListView__scrollContainer {
	flex-grow: 1;
	flex-shrink: 1;
	min-height: 0;
}

/* Hide the scrollbars — the list is still scrollable via touch/drag/wheel.
*Note, this is the dumbest thing ever, but Unity's UI Toolkit does not provide a way to hide the scrollbars via USS. But you can in C#*/
.elasticListView__scrollContainer .unity-scroll-view__vertical-scroller,
.elasticListView__scrollContainer .unity-scroll-view__horizontal-scroller {
	display: none;
}

.elasticListView__content {
	flex-direction: column;
}

.elasticListView__emptyLabel {
	flex-grow: 1;
	padding-top: 100px;
	-unity-text-align: middle-center;
	white-space: normal;
}

.elasticListView__loadMoreFooter {
	flex-shrink: 0;
	height: 64px;
	margin-bottom: 16px;
	align-items: center;
	justify-content: center;
}

.elasticListView__loadMoreSpinner {
	width: 40px;
	height: 40px;
}
