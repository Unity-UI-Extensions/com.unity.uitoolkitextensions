/* ============================================================
   SideDrawer.uss
   Reads ThemeTokens only. The panel and scrim move by transitions on
   translate and opacity, so .reduce-motion makes them instant.
   ============================================================ */

.sideDrawer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.sideDrawer__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--c-scrim);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-base);
}

.sideDrawer__edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 20px;
}

.sideDrawer--left > .sideDrawer__edge {
    left: 0;
}

.sideDrawer--right > .sideDrawer__edge {
    right: 0;
}

.sideDrawer__panel {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: var(--surface-bg);
    border-color: var(--surface-border);
    transition-property: translate;
    transition-duration: var(--motion-base);
    transition-timing-function: ease-out-cubic;
}

.sideDrawer--left > .sideDrawer__panel {
    left: 0;
    border-right-width: 1px;
    border-top-right-radius: var(--radius-sheet);
    border-bottom-right-radius: var(--radius-sheet);
}

.sideDrawer--right > .sideDrawer__panel {
    right: 0;
    border-left-width: 1px;
    border-top-left-radius: var(--radius-sheet);
    border-bottom-left-radius: var(--radius-sheet);
}

.sideDrawer--permanent > .sideDrawer__panel {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.sideDrawer--dragging > .sideDrawer__panel,
.sideDrawer--dragging > .sideDrawer__scrim {
    transition-duration: 0s;
}

.sideDrawer__content {
    flex-grow: 1;
}

.sideDrawer__section {
    padding-top: var(--space-4);
}

.sideDrawer__sectionTitle {
    padding-left: var(--space-4);
    padding-bottom: var(--space-2);
    font-size: var(--text-caption);
    -unity-font-definition: var(--font-body-semibold);
    color: var(--surface-muted);
}

/* Settings rows in the drawer (FS09_3) draw their chevron at 18, smaller than the 20 of a settings screen. */
.sideDrawer .settingsRow__chevron {
    width: 18px;
    height: 18px;
}
