/* ============================================================
   QRCodeView.uss
   Reads ThemeTokens only. --qr-dark and --qr-light are read by
   C# for the texture; keep them high in contrast so codes scan.
   ============================================================ */

.qrCodeView {
    --qr-dark: var(--c-navy-2);
    --qr-light: #FFFFFF;
    width: 200px;
    height: 200px;
    flex-shrink: 0;
    background-color: var(--qr-light);
    border-radius: var(--radius-sm);
    -unity-background-scale-mode: scale-to-fit;
}

.qrCodeView.qrCodeView--empty {
    opacity: 0.4;
}

/* QRCodeCard (FS04_5): the code on the left, the title, link and actions beside it. */
.qrCodeCard {
    flex-direction: row;
    align-items: center;
}

.qrCodeCard--card {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    padding-left: 18px;
    padding-right: 18px;
    border-width: 1px;
    border-color: var(--surface-border);
    border-radius: 18px;
    background-color: var(--surface-raised);
}

.qrCodeCard__code {
    margin-right: 14px;
}

.qrCodeCard__texts {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.qrCodeCard__title {
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-definition: var(--font-display);
    -unity-font-style: bold;
    color: var(--surface-fg);
}

.qrCodeCard__caption {
    margin: 0;
    margin-top: var(--space-1);
    padding: 0;
    font-size: var(--text-caption);
    color: var(--surface-muted);
    white-space: normal;
}

.qrCodeCard__links {
    flex-direction: row;
    margin-top: var(--space-1);
}

.qrCodeCard__link {
    margin: 0;
    margin-right: var(--space-4);
    padding: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: var(--text-caption);
    -unity-font-definition: var(--font-body-semibold);
    -unity-font-style: bold;
    color: var(--surface-accent);
}

.qrCodeCard__link:focus {
    border-bottom-width: 1px;
    border-bottom-color: var(--surface-accent);
}
