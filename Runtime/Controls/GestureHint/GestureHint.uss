/* ============================================================
   GestureHint.uss
   Reads ThemeTokens only. Fades in and out with --motion-base.
   ============================================================ */

.gestureHint {
    flex-direction: row;
    align-items: center;
    align-self: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--c-panel);
    border-width: 1px;
    border-color: var(--c-divider);
    border-radius: var(--radius-pill);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-base);
}

.gestureHint.gestureHint--shown {
    opacity: 1;
}

.gestureHint__item {
    flex-direction: row;
    margin-right: var(--space-3);
}

.gestureHint__prefix,
.gestureHint__verb {
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
    font-size: var(--text-micro);
    -unity-font-definition: var(--font-body-medium);
    letter-spacing: 14px;
}

.gestureHint__prefix {
    margin-right: 4px;
    color: var(--c-fg-muted);
}

.gestureHint__verb {
    color: var(--c-fg);
}

.gestureHint__inspector {
    margin-left: var(--space-1);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    font-size: var(--text-caption);
    -unity-font-definition: var(--font-body-medium);
    color: var(--c-accent);
    border-left-width: 1px;
    border-left-color: var(--c-divider);
}
