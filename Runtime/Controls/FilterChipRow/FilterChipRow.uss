/* ============================================================
   FilterChipRow.uss
   Reads ThemeTokens only. Chips as in FS09_1 (.chip, .chip.on).
   ============================================================ */

.filterChipRow {
    flex-grow: 0;
    flex-shrink: 0;
}

.filterChipRow .unity-scroll-view__content-container {
    flex-direction: row;
}

.filterChipRow__chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 38px;
    margin: 0;
    margin-right: var(--space-2);
    padding-top: 0;
    padding-bottom: 0;
    padding-left: var(--space-4);
    padding-right: var(--space-3);
    border-width: 1.5px;
    border-color: var(--surface-border-strong);
    border-radius: var(--radius-pill);
    background-color: var(--surface-raised);
    -unity-background-scale-mode: stretch-to-fill;
}

.filterChipRow__chip:hover,
.filterChipRow__chip:active {
    background-color: var(--surface-pressed);
}

.filterChipRow__chip:focus {
    border-color: var(--surface-accent);
}

.filterChipRow__label {
    margin: 0;
    padding: 0;
    font-size: var(--text-label-sm);
    -unity-font-definition: var(--font-body-medium);
    color: var(--surface-fg);
    white-space: nowrap;
}

.filterChipRow__chevron {
    width: 16px;
    height: 16px;
    margin-left: var(--space-1);
    background-image: url("../../Assets/Icons/ChevronDown.svg");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--surface-fg);
}

.filterChipRow__chip--active {
    border-color: rgba(0, 0, 0, 0);
}

.filterChipRow__chip--active > .filterChipRow__label {
    color: var(--c-on-primary);
}

.filterChipRow__chip--active > .filterChipRow__chevron {
    -unity-background-image-tint-color: var(--c-on-primary);
}

/* The Clear chip is a label chip with no chevron. */
.filterChipRow__clear {
    padding-right: var(--space-4);
    font-size: var(--text-label-sm);
    -unity-font-definition: var(--font-body-medium);
    color: var(--surface-accent);
    -unity-text-align: middle-center;
}
