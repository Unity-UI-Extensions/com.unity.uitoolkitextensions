/* ============================================================
   SectionList.uss
   Reads ThemeTokens only. Sections are CollapsibleSection cards;
   rows are SettingsRows unless a RowFactory builds them.
   ============================================================ */

.sectionList {
    flex-direction: column;
}

.sectionList .sectionList__section > .collapsibleSection__body > .collapsibleSection__bodyContent {
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
}

.sectionList__count {
    min-width: 24px;
    margin-right: var(--space-2);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    border-radius: var(--radius-pill);
    background-color: var(--surface-border);
    font-size: var(--text-caption);
    -unity-font-definition: var(--font-body-medium);
    color: var(--surface-muted);
    -unity-text-align: middle-center;
}

.sectionList__chevron {
    width: 20px;
    height: 20px;
    background-image: url("../../Assets/Icons/ChevronDown.svg");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--surface-muted);
    rotate: 0deg;
    transition-property: rotate;
    transition-duration: var(--motion-base);
}

.collapsibleSection--expanded .sectionList__chevron {
    rotate: 180deg;
}
