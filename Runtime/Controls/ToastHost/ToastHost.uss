/* ============================================================
   ToastHost.uss
   Reads ThemeTokens only. Toasts enter and leave by a transition on
   opacity and translate; the swipe offsets the inner card inline.
   ============================================================ */

.toastHost {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
}

.toastHost--top {
    justify-content: flex-start;
}

.toastHost--bottom {
    justify-content: flex-end;
}

.toastHost > .toastHost__toast {
    width: 100%;
    max-width: 480px;
    margin-top: var(--space-2);
    opacity: 0;
    translate: 0 -12px;
    transition-property: opacity, translate;
    transition-duration: var(--motion-base);
    transition-timing-function: ease-out-cubic;
}

.toastHost--bottom > .toastHost__toast {
    margin-top: 0;
    margin-bottom: var(--space-2);
    translate: 0 12px;
}

.toastHost > .toastHost__toast.toastHost__toast--shown {
    opacity: 1;
    translate: 0 0;
}

.toastHost__card {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-4);
    padding-right: var(--space-2);
    background-color: var(--surface-bg);
    border-width: 1px;
    border-color: var(--surface-border);
    border-radius: var(--radius-card);
}

.toastHost__toast--success > .toastHost__card {
    border-left-width: 3px;
    border-left-color: var(--c-success);
}

.toastHost__toast--warning > .toastHost__card {
    border-left-width: 3px;
    border-left-color: var(--c-warn);
}

.toastHost__toast--error > .toastHost__card {
    border-left-width: 3px;
    border-left-color: var(--c-danger);
}

.toastHost__texts {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.toastHost__message {
    white-space: normal;
    color: var(--surface-fg);
    font-size: var(--text-label);
    -unity-font-definition: var(--font-body-medium);
}

.toastHost__detail {
    margin-top: 3px;
    white-space: normal;
    color: var(--surface-muted);
    font-size: var(--text-caption);
    -unity-font-definition: var(--font-body);
}

.toastHost__icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    margin-right: var(--space-3);
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background-color: var(--c-accent);
}

.toastHost__iconImage {
    width: 18px;
    height: 18px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--c-bg);
}

.toastHost__progress {
    height: 3px;
    margin-top: var(--space-1);
    border-radius: 2px;
    background-color: var(--surface-border);
    overflow: hidden;
}

.toastHost__progressFill.gradientFill {
    --gradient-start: var(--c-primary);
    --gradient-end: var(--c-accent);
    height: 100%;
    transition-property: width;
    transition-duration: var(--motion-base);
}

.toastHost__toast--progress > .toastHost__card {
    border-left-width: 3px;
    border-left-color: var(--c-accent);
}

/* The icon disc takes the tone: success and error discs carry a white glyph, warning a dark one. */
.toastHost__toast--success .toastHost__icon {
    background-color: var(--c-success);
}

.toastHost__toast--warning .toastHost__icon {
    background-color: var(--c-warn);
}

.toastHost__toast--error .toastHost__icon {
    background-color: var(--c-danger);
}

.toastHost__toast--success .toastHost__iconImage,
.toastHost__toast--error .toastHost__iconImage {
    -unity-background-image-tint-color: var(--c-fg);
}

/* The action is a small ghost pill, as on FS03_2 and FS03_6. */
.toastHost__action.toastHost__action {
    height: 34px;
    min-height: 34px;
    flex-shrink: 0;
    margin-left: var(--space-3);
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1.5px;
    border-color: var(--surface-border-strong);
    border-radius: var(--radius-pill);
    color: var(--surface-accent);
    font-size: var(--text-caption);
    -unity-font-definition: var(--font-body-semibold);
    -unity-font-style: bold;
}

.toastHost__action.toastHost__action:hover,
.toastHost__action.toastHost__action:active {
    background-color: var(--surface-pressed);
}

/* Thumbnail (FS08_3): the saved photo in place of the icon disc. */
.toastHost__thumbnail {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    margin-right: var(--space-3);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--surface-border-strong);
    background-color: var(--surface-raised);
    -unity-background-scale-mode: scale-and-crop;
}

/* Icon action (FS08_3 Share): a 48 px round button with an accent glyph, no border. */
.toastHost__toast--iconAction .toastHost__action.toastHost__action {
    width: 48px;
    height: 48px;
    min-height: 48px;
    margin-left: var(--space-2);
    padding-left: 0;
    padding-right: 0;
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.toastHost__actionIcon {
    width: 22px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--surface-accent);
}
