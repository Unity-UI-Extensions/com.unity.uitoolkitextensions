/* ============================================================
   ContentGrid.uss
   Reads ThemeTokens only.
   ============================================================ */

.contentGrid {
    flex-grow: 1;
}

.contentGrid__list {
    flex-grow: 1;
}

/* ListView virtualises rows; only the individual tiles own interaction feedback. */
.contentGrid__list .unity-list-view__item,
.contentGrid__list .unity-list-view__item:hover,
.contentGrid__list .unity-list-view__item:checked,
.contentGrid__list .unity-collection-view__item,
.contentGrid__list .unity-collection-view__item:hover,
.contentGrid__list .unity-collection-view__item:checked {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.contentGrid__row {
    flex-direction: row;
    /* The list places every row at one fixed height, measured from the tiles (ContentGrid.cs). The tiles keep their own height
       rather than stretching or shrinking to the row's, so they can be measured, and so a row never squashes them. */
    align-items: flex-start;
    flex-shrink: 0;
    padding-left: var(--space-1);
    padding-right: var(--space-1);
}

.contentGrid__tile {
    flex-shrink: 0;
    padding-left: var(--space-1);
    padding-right: var(--space-1);
    padding-top: var(--space-1);
    padding-bottom: var(--space-3);
}

.contentGrid__tile.contentGrid__tile--hidden {
    visibility: hidden;
}

.contentGrid__thumb {
    width: 100%;
    flex-shrink: 0;
    border-radius: var(--radius-card);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--surface-skeleton);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
    transition-property: scale;
    transition-duration: var(--motion-fast);
}

.contentGrid__tile--selected .contentGrid__thumb {
    border-color: var(--surface-accent);
}

.contentGrid__tile--armed .contentGrid__thumb {
    scale: 1.04 1.04;
}

/* A disabled item (ContentGridItem.IsEnabled false): greyed out in place. The badge sits inside the thumbnail, so it
   dims with it. Each part dims on its own, so an application can keep one legible, such as a reason in the meta line. */
.contentGrid__tile--disabled .contentGrid__thumb,
.contentGrid__tile--disabled .contentGrid__name,
.contentGrid__tile--disabled .contentGrid__meta {
    opacity: 0.45;
}

.contentGrid__badge {
    position: absolute;
    left: var(--space-2);
    top: var(--space-2);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: var(--radius-pill);
    background-color: var(--c-scrim);
    color: var(--c-on-primary);
    font-size: var(--text-caption);
    -unity-font-definition: var(--font-body-semibold);
}

.contentGrid__check {
    display: none;
    position: absolute;
    right: var(--space-2);
    top: var(--space-2);
    width: 24px;
    height: 24px;
    border-radius: var(--radius-pill);
    background-color: var(--surface-accent);
    background-image: url("../../Assets/Icons/Check.svg");
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    -unity-background-image-tint-color: var(--c-on-primary);
}

.contentGrid__tile--selected .contentGrid__check {
    display: flex;
}

.contentGrid__name {
    margin-top: var(--space-2);
    font-size: var(--text-label);
    -unity-font-definition: var(--font-body-medium);
    color: var(--surface-fg);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.contentGrid__meta {
    font-size: var(--text-caption);
    -unity-font-definition: var(--font-body);
    color: var(--surface-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.contentGrid__skeleton,
.contentGrid__empty {
    flex-grow: 1;
}
